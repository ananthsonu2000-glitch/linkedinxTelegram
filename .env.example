# Copy this file to .env and fill in your real values. Never commit .env.

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model to use.
GEMINI_MODEL=gemini-3.5-flash

# Minimum overall rating (1-10) a thought needs before the bot writes a post.
RATING_THRESHOLD=8

# Optional but recommended: restrict the bot to only respond to you.
# Send /whoami to the bot once (after first run) to find your numeric Telegram user id,
# then set it here and restart the bot.
ALLOWED_USER_ID=
